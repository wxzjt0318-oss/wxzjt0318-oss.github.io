# 依赖
node_modules/

# 环境与密钥（本地配置不入库）
.env
.env.local
.env.*.local
config/storages.json
config/settings.json
config/env.ci.json

# 构建产物
dist/
web/dist/
.edgeone/

# 边缘函数构建期生成的清单（由 scripts/build-api-manifest.mjs 生成）
functions/generated/

# 本地运行数据
tool/data/

# 图源素材：只进存储，不进仓库
pics/
_inbox/
_selftest/
docs/

# 本地验证证据（截图 / 日志等临时产物）
docs/archive/scratch/

# 助手工作笔记（保留在磁盘上，只是不进版本库）
.workbuddy-ai/
.workbuddy/

# 本地部署流水线覆盖文件（.cnb.yml 已入库，仅本地覆盖忽略）
.cnb.local.yml

# 前端图片索引（含真实图片 URL 与元数据，只由 build-index 本地/CI 生成）
web/public/data/gallery-index.json

*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
