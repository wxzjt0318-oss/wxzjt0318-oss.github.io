	return getInfoboxValues(subject, keys);
}

function toDisplayYearOrYearMonth(input?: string): string {
	if (!input) {
		return T.unknown;
	}
	const s = input.trim();
	const ymd = /^(\d{4})-(\d{2})-(\d{2})$/;
	const ym = /^(\d{4})-(\d{2})$/;
	const y = /^(\d{4})$/;
	if (ymd.test(s) || ym.test(s) || y.test(s)) {
		return s;
	}
	const mYMD = s.match(/(\d{4})[-/年](\d{1,2})[-/月](\d{1,2})/);
	if (mYMD) {
		const year = mYMD[1];
		const mm = String(mYMD[2]).padStart(2, "0");
		const dd = String(mYMD[3]).padStart(2, "0");
		return `${year}-${mm}-${dd}`;
	}
	const mYM = s.match(/(\d{4})[-/年](\d{1,2})/);
	if (mYM) {
		const year = mYM[1];
		const mm = String(mYM[2]).padStart(2, "0");
		return `${year}-${mm}`;
	}
	const mY = s.match(/(\d{4})/);
	if (mY) {
		return mY[1];
	}
	return T.unknown;
}

function toTime(input?: string) {
	if (!input) {
		return 0;
	}
	const s = input.trim();
	if (/^\d{4}$/.test(s)) {
		return Date.parse(`${s}-01-01T00:00:00Z`);
	}
	if (/^\d{4}-\d{2}$/.test(s)) {
		return Date.parse(`${s}-01T00:00:00Z`);
	}
	const t = Date.parse(s);
	return Number.isNaN(t) ? 0 : t;
}

async function fetchSubjectDetailRaw(
	subjectId: number,
): Promise<BangumiSubject> {
	// CI（GitHub Actions 海外节点）到 api.bgm.tv 的往返远高于本地，超时从 500ms 提到 10s
	const res = await fetchWithRetry(
		`${BANGUMI_API_BASE}/v0/subjects/${subjectId}`,
		{ headers: BANGUMI_REQUEST_HEADERS },
		3,
		500,
		10000,
	);
	const ct = res.headers.get("content-type") || "";
	if (!ct.includes("application/json")) {
		throw new Error(`Bangumi subject ${subjectId} non-JSON`);
	}
	return await res.json();
}

async function fetchSubjectDetailCached(
	subjectId: number,
): Promise<BangumiSubject | null> {
	const cacheKey = `subject-${subjectId}`;
	const cached = await diskCacheGet<BangumiSubject>(cacheKey, CACHE_TTL_HOURS);
	if (cached) {
		return cached;
	}
	if (GAMES_FETCH_OFFLINE) {
		// 离线模式：不发起网络请求，接受任意陈旧缓存
		return await diskCacheGet<BangumiSubject>(
			cacheKey,
			Number.POSITIVE_INFINITY,
		);
	}
	try {
		const detail = await fetchSubjectDetailRaw(subjectId);
		await diskCacheSet(cacheKey, detail);
		return detail;
	} catch {
		// API 故障时回退到任意陈旧的缓存
		return await diskCacheGet<BangumiSubject>(
			cacheKey,
			Number.POSITIVE_INFINITY,
		);
	}
}

function stripTags(input: string): string {
	return String(input || "").replace(/<[^>]+>/g, " ");
}

function extractDeveloperFromHtml(html: string): string[] {
	const entries: string[] = [];
	const liBlocks = html.match(/<li[^>]*>[\s\S]*?<\/li>/gi) || [];
	for (const block of liBlocks) {
		const tip = block.match(/<span[^>]*class="tip"[^>]*>(.*?)<\/span>/i);
		const label = tip ? stripTags(tip[1]).trim() : "";
		if (!label) {
			continue;
		}
		if (!/开发|开发商|開発|Developer|Developers/i.test(label)) {
			continue;
		}
		const text = stripTags(block.replace(tip?.[0] || "", ""));
		const anchors = Array.from(block.matchAll(/<a[^>]*>(.*?)<\/a>/gi)).map(
			(m) => stripTags(m[1]).trim(),
		);
		const rawList = anchors.length ? anchors : splitValueTokens(text);
		entries.push(...rawList);
	}
	return normalizeDeveloperList(entries);
}

async function fetchDeveloperFromHtml(subjectId: number): Promise<string[]> {
	// 禁用缓存，直接从 API 获取最新数据
	try {
		const res = await fetchWithRetry(
			`https://bgm.tv/subject/${subjectId}`,
			{ headers: { "User-Agent": BANGUMI_REQUEST_HEADERS["User-Agent"] } },
			2,
			500,
			10000,
		);
		const html = await res.text();
		return extractDeveloperFromHtml(html);
	} catch {
		return [];
	}
}

async function mapWithConcurrency<T, R>(
	items: T[],
	limit: number,
	fn: (item: T, index: number) => Promise<R>,
) {
	const results: R[] = new Array(items.length);
	let idx = 0;
	const runners = Array.from(
		{ length: Math.min(limit, items.length) },
		async () => {
			while (idx < items.length) {
				const current = idx++;
				results[current] = await fn(items[current], current);
			}
		},
	);
	await Promise.all(runners);
	return results;
}

function unescapeHtmlText(value: string): string {
	return String(value || "")
		.replace(/&amp;/g, "&")
		.replace(/&lt;/g, "<")
		.replace(/&gt;/g, ">")
		.replace(/&quot;/g, '"')
		.replace(/&#0?39;/g, "'")
		.replace(/&nbsp;/g, " ")
		.trim();
}

/** 解析一页游戏收藏列表 HTML，返回类 API 形状的条目（详情由 /v0/subjects 另行补全） */
function parseGameListPageItems(html: string): BangumiCollectionItem[] {
	const items: BangumiCollectionItem[] = [];
	const itemRe = /<li id="item_(\d+)"[\s\S]*?<\/li>/g;
	let match = itemRe.exec(html);
	while (match !== null) {
		const subjectId = Number(match[1]);
		const block = match[0];
		const titleMatch = block.match(
			/<a href="\/subject\/\d+" class="l">([\s\S]*?)<\/a>\s*(?:<small class="grey">([\s\S]*?)<\/small>)?/,
		);
		const coverMatch = block.match(/<img src="([^"]+)" class="cover"/);
		const rateMatch = block.match(/starlight stars(\d+)/);
		const dateMatch = block.match(/<span class="tip_j">([\d-]+)<\/span>/);

		let cover = coverMatch ? coverMatch[1] : "";
		if (!cover || cover.includes("no_icon_subject")) {
			cover = "";
		}
		if (cover.startsWith("//")) {
			cover = `https:${cover}`;
		}

		items.push({
			subject_id: subjectId,
			rate: rateMatch ? Number(rateMatch[1]) : 0,
			updated_at: dateMatch ? dateMatch[1] : "",
			subject: {
				name_cn: unescapeHtmlText(titleMatch?.[1] || ""),
				name: unescapeHtmlText(titleMatch?.[2] || ""),
				...(cover ? { images: { medium: cover } } : {}),
			},
		});
		match = itemRe.exec(html);
	}
	return items;
}

/**
 * 主站游戏列表页回退：api.bgm.tv 的 /v0/users/* 子树故障（如整体 502）时，
 * 改抓 bgm.tv/game/list/{user}/{segment} 分页 HTML（每页 24 条）。
 */
async function fetchGameCollectionFromHtml(userId: string, type: number) {
	const segment = GAME_HTML_TYPE_SEGMENTS[type];
	if (!segment) {
		return null;
	}
	const allData: BangumiCollectionItem[] = [];
	const seen = new Set<number>();
	for (let page = 1; ; page++) {
		const url = `${BANGUMI_WEB_BASE}/game/list/${encodeURIComponent(userId)}/${segment}?page=${page}`;
		let html = "";
		try {
			const res = await fetchWithRetry(
				url,
				{ headers: BANGUMI_WEB_HEADERS },
				2,
				500,
				15000,
			);
			html = await res.text();
		} catch {
			break;
		}
		const pageItems = parseGameListPageItems(html);
		if (pageItems.length === 0) {
			break;
		}
		for (const item of pageItems) {
			if (seen.has(item.subject_id)) {
				continue;
			}
			seen.add(item.subject_id);
			allData.push(item);
			if (allData.length >= MAX_ITEMS) {
				break;
			}
		}
		if (allData.length >= MAX_ITEMS) {
			break;
		}
		await new Promise((resolve) => setTimeout(resolve, 120));
	}
	return allData.length > 0 ? { data: allData } : null;
}

async function fetchBangumiCollection(
	userId: string,
	subjectType: number,
	type: number,
) {
	const cacheKey = `collection-${userId}-${subjectType}-${type}`;
	const cached = await diskCacheGet<BangumiCollectionPayload>(
		cacheKey,
		CACHE_TTL_HOURS,
	);
	if (cached?.data?.length) {
		return cached;
	}
	if (GAMES_FETCH_OFFLINE) {
		// 离线模式：零网络请求，陈旧缓存兜底，保证构建不会被网络拖死
		const stale = await diskCacheGet<BangumiCollectionPayload>(
			cacheKey,
			Number.POSITIVE_INFINITY,
		);
		return stale?.data?.length ? stale : null;
	}
	try {
		let allData: BangumiCollectionItem[] = [];
		let offset = 0;
		const pageLimit = 50;
		while (true) {
			const url = `${BANGUMI_API_BASE}/v0/users/${userId}/collections?subject_type=${subjectType}&type=${type}&limit=${pageLimit}&offset=${offset}`;
			const response = await fetchWithRetry(
				url,
				{ headers: BANGUMI_REQUEST_HEADERS },
				3,
				500,
				15000,
			);
			const data = await response.json();
			const batch = data.data || [];
			if (batch.length > 0) {
				allData = [...allData, ...batch];
			}
			if (allData.length >= MAX_ITEMS) {
				allData = allData.slice(0, MAX_ITEMS as number);
				break;
			}
			const hasMore = batch.length === pageLimit;
			if (!hasMore) {
				break;
			}
			offset += pageLimit;
			await new Promise((resolve) => setTimeout(resolve, 120));
		}
		const payload = { data: allData };
		await diskCacheSet(cacheKey, payload);
		return payload;
	} catch {
		// API 故障（如 api.bgm.tv /v0/users/* 502）时优先回退主站 HTML 列表页（数据仍是新的），
		// 再退到任意陈旧的缓存，避免构建出空页面
		const fromHtml = await fetchGameCollectionFromHtml(userId, type);
		if (fromHtml) {
			await diskCacheSet(cacheKey, fromHtml);
			return fromHtml;
		}
		const stale = await diskCacheGet<BangumiCollectionPayload>(
			cacheKey,
			Number.POSITIVE_INFINITY,
		);
		return stale?.data?.length ? stale : null;
	}
}

