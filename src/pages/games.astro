              aria-label={i18n(I18nKey.layoutGrid)}
              title={i18n(I18nKey.layoutGrid)}
              aria-pressed="true"
            >
              <Icon name="material-symbols:grid-view-rounded" class="text-xl" aria-hidden="true" />
            </button>
            <button
              id="layout-list"
              type="button"
              class="layout-switch__btn"
              aria-label={i18n(I18nKey.layoutList)}
