    }

    @media (max-width: 640px) {
      .game-grid-container.grid-mode { grid-template-columns: repeat(2, 1fr); }
      /* 列表模式在窄屏改为单列横向卡片（封面左、信息右），与网格模式明显区分 */
      .game-grid-container.list-mode { grid-template-columns: 1fr; }

      #game-list-container.list-mode > [data-game-status] { display: flex; flex-direction: row; }
      #game-list-container.list-mode > [data-game-status] > [class*="aspect-"] {
        width: 7.5rem; flex: 0 0 7.5rem; aspect-ratio: auto;
      }
      #game-list-container.list-mode > [data-game-status] > .p-3 { flex: 1 1 auto; min-width: 0; }

      .group .p-3 { padding: 0.875rem; }
      .group h3 { font-size: 1rem; line-height: 1.5; }
