function normalizeDeveloperName(name: string): string {
	let v = String(name || "").trim();
	v = v.replace(/[（(].*?[）)]/g, " ");
	v = v.replace(/\s+/g, " ").trim();
	const key = v.toLowerCase();
	const mapped = DEVELOPER_ALIAS_MAP[key];
	return mapped || v;
}

function normalizeDeveloperList(values: string[]): string[] {
	const normalized = values
		.map((v) => normalizeDeveloperName(v))
		.filter(Boolean);
	return dedupeList(normalized);
}

function pickBetterDeveloperName(a: string, b: string): string {
	if (!a) {
		return b;
	}
	if (!b) {
		return a;
	}
	if (a === b) {
		return a;
	}
	const aHasCjk = /[\u4e00-\u9fff]/.test(a);
	const bHasCjk = /[\u4e00-\u9fff]/.test(b);
	if (aHasCjk !== bHasCjk) {
		return aHasCjk ? a : b;
	}
	return a.length >= b.length ? a : b;
}

function mergeDeveloperValues(
	primary: string[],
	secondary: string[],
): string[] {
	const merged: Record<string, string> = {};
	for (const name of [...primary, ...secondary]) {
		const normalized = normalizeDeveloperName(name);
		if (!normalized) {
			continue;
		}
		const key = normalized.toLowerCase();
		merged[key] = pickBetterDeveloperName(merged[key] || "", normalized);
	}
	return Object.values(merged);
}

/** 人员/关联条目可能被包装为 { person: ... }，统一取出可读名称 */
type NamedEntity = {
	name?: unknown;
	name_cn?: unknown;
	person?: unknown;
};

function pickName(value: unknown): string {
	if (typeof value === "string") {
		return value.trim();
	}
	if (value && typeof value === "object") {
		const entity = value as NamedEntity;
		if (typeof entity.name_cn === "string" && entity.name_cn.trim()) {
			return entity.name_cn.trim();
		}
		if (typeof entity.name === "string" && entity.name.trim()) {
			return entity.name.trim();
		}
		if (entity.person) {
			return pickName(entity.person);
		}
	}
	return "";
}

function getStaffNamesByJobs(
	subject: BangumiSubject | null | undefined,
	jobMatchers: RegExp[],
): string[] {
	const staff = Array.isArray(subject?.staff) ? subject.staff : [];
	const names: string[] = [];
	for (const member of staff) {
		const m = member as {
			jobs?: unknown;
			job?: unknown;
			role?: unknown;
		} | null;
		const jobs: string[] = [];
		if (Array.isArray(m?.jobs)) {
			jobs.push(...m.jobs.map((j) => String(j || "")));
		}
		if (typeof m?.job === "string") {
			jobs.push(m.job);
		}
		if (typeof m?.role === "string") {
			jobs.push(m.role);
		}
		const jobText = jobs.join(" ");
		if (!jobText) {
			continue;
		}
		if (!jobMatchers.some((m) => m.test(jobText))) {
			continue;
		}
		const name = pickName(member);
		if (name) {
			names.push(name);
		}
	}
	return dedupeList(names);
}

function getRelationNamesByTypes(
	subject: BangumiSubject | null | undefined,
	relationMatchers: RegExp[],
): string[] {
	const relations = Array.isArray(subject?.relations) ? subject.relations : [];
	const names: string[] = [];
	for (const rel of relations) {
		const r = rel as { relation?: unknown; type?: unknown } | null;
		const relText = String(r?.relation || r?.type || "").trim();
		if (!relText) {
			continue;
		}
		if (!relationMatchers.some((m) => m.test(relText))) {
			continue;
		}
		const name = pickName(rel);
		if (name) {
			names.push(name);
		}
	}
	return dedupeList(names);
}

