                        <div class="flex flex-wrap gap-1 mt-2">
                          {(game.genre || []).map((g) => (
                            <span class="px-1.5 py-0.5 bg-[var(--btn-regular-bg)] text-gray-700 dark:text-gray-300 rounded text-xs">{g}</span>
