                          </div>
                        )}
                        {showPlatform && (
                          <div class="flex justify-between">
                            <span class="text-gray-500 dark:text-gray-500">{T.platform}</span>
                            <span class="text-gray-700 dark:text-gray-300 truncate ml-2" data-game-platform-text>{game.platform || T.unknown}</span>
                          </div>
