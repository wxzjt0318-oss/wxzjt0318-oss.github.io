            <Icon name="material-symbols:search-off-outline-rounded" class="games-empty__icon" aria-hidden="true" />
            <h3 class="text-xl font-medium text-black/80 dark:text-white/80 mb-2">
              {i18n(I18nKey.gamesNoResults)}
            </h3>
            <p class="text-black/60 dark:text-white/60">
              {i18n(I18nKey.gamesEmptyHint)}
            </p>
