}

async function fetchWithRetry(
	url: string,
	init?: RequestInit,
	retries = 3,
	baseDelayMs = 300,
	timeoutMs = 10000,
): Promise<Response> {
	let lastErr: unknown = null;
	for (let attempt = 0; attempt <= retries; attempt++) {
		let res: Response | null = null;
		try {
			const controller =
				typeof AbortController !== "undefined" ? new AbortController() : null;
			const timeoutId = controller
				? setTimeout(() => controller.abort(), Math.max(0, timeoutMs))
				: null;
			try {
				res = (await fetch(url, {
					...(init || {}),
					signal: controller?.signal,
				})) as Response;
			} finally {
				if (timeoutId) {
					clearTimeout(timeoutId);
				}
			}
		} catch (e) {
			lastErr = e;
		}
		if (res?.ok) {
			return res;
		}
		const status = res?.status ?? 0;
		const isTimeout =
			typeof lastErr === "object" &&
			lastErr !== null &&
			(lastErr as { name?: unknown }).name === "AbortError";
		const retryable =
			status === 429 || (status >= 500 && status <= 599) || isTimeout;
		if (attempt < retries && retryable) {
			let delay = baseDelayMs * 2 ** attempt;
			const ra = res?.headers?.get("Retry-After");
			const s = ra ? Number(ra) : Number.NaN;
			if (!Number.isNaN(s) && s > 0) {
				delay = s * 1000;
			}
			delay += Math.floor(Math.random() * 200);
			await new Promise((r) => setTimeout(r, delay));
			continue;
		}
		if (res) {
			throw new Error(`HTTP ${res.status} ${res.statusText} for ${url}`);
		}
		if (isTimeout) {
			throw new Error(`Timeout after ${timeoutMs}ms for ${url}`);
		}
		throw new Error(`Network error: ${String(lastErr)}`);
	}
	throw new Error(`fetchWithRetry exhausted for ${url}`);
}

function pickFirstUsefulValue(v: unknown): string | undefined {
	if (v == null) {
		return undefined;
	}
	if (typeof v === "string") {
		return v.trim() || undefined;
	}
	if (Array.isArray(v)) {
		for (const it of v) {
			const got = pickFirstUsefulValue(it);
			if (got) {
				return got;
			}
		}
		return undefined;
	}
	if (typeof v === "object") {
		const wrapped = v as { v?: unknown; value?: unknown };
		if (typeof wrapped.v === "string") {
			return wrapped.v.trim() || undefined;
		}
		if (typeof wrapped.value === "string") {
			return wrapped.value.trim() || undefined;
		}
	}
	return undefined;
}

function normalizeValue(input: string): string {
	return input.replace(/\s+/g, " ").trim();
}

function flattenInfoboxValues(value: unknown): string[] {
	if (value == null) {
		return [];
	}
	if (typeof value === "string") {
		return [normalizeValue(value)].filter(Boolean);
	}
	if (Array.isArray(value)) {
		return value.flatMap((v) => flattenInfoboxValues(v));
	}
	if (typeof value === "object") {
		const wrapped = value as { v?: unknown; value?: unknown };
		if (typeof wrapped.v === "string") {
			return [normalizeValue(wrapped.v)].filter(Boolean);
		}
		if (typeof wrapped.value === "string") {
			return [normalizeValue(wrapped.value)].filter(Boolean);
		}
	}
	return [];
}

function getInfoboxValues(
	subject: BangumiSubject | null | undefined,
	keys: string[],
): string[] {
	const infobox = subject?.infobox;
	if (!Array.isArray(infobox)) {
		return [];
	}
	const results: string[] = [];
	for (const k of keys) {
		const entries = infobox.filter((x) => x?.key === k);
		for (const entry of entries) {
			results.push(...flattenInfoboxValues(entry?.value));
		}
	}
	return results;
}

function splitValueTokens(value: string): string[] {
	if (!value) {
		return [];
	}
	let v = value.replace(/[（(][^）)]*[）)]/g, " ");
	v = v
		.replace(/[，、]/g, ",")
		.replace(/[／]/g, "/")
		.replace(/[＆]/g, "&");
	v = v.replace(/xbox\s*series\s*x\|s/gi, "Xbox Series X/S");
	v = v.replace(/xbox\s*series\s*s\|x/gi, "Xbox Series X/S");
	const parts = v
		.split(/[/,|&+]/)
		.flatMap((p) => p.split(/(?:和|与|及|以及)/))
		.map((p) => normalizeValue(p))
		.filter(Boolean);
	return parts.length ? parts : [normalizeValue(value)].filter(Boolean);
}

function dedupeList(values: string[]): string[] {
	const seen = new Set<string>();
	const result: string[] = [];
	for (const v of values) {
		const key = v.toLowerCase();
		if (!seen.has(key)) {
			seen.add(key);
			result.push(v);
		}
	}
	return result;
}

