type DiskCacheEnvelope<T> = { savedAt?: string; payload?: T };

function diskCacheFile(key: string): string {
	return path && cacheRoot
		? path.resolve(cacheRoot, `${encodeURIComponent(key)}.json`)
		: "";
}

async function diskCacheGet<T>(
	key: string,
	ttlHours: number,
): Promise<T | null> {
	if (!isNode || !fs || !cacheRoot) {
		return null;
	}
	try {
		const raw = await fs.readFile(diskCacheFile(key), {
			encoding: "utf8",
		});
		const envelope = JSON.parse(
			typeof raw === "string" ? raw : String(raw),
		) as DiskCacheEnvelope<T>;
		if (!envelope || envelope.payload == null) {
			return null;
		}
		// ttlHours 传 Infinity 表示接受任意陈旧的缓存（故障兜底）
		if (Number.isFinite(ttlHours)) {
			const saved = Date.parse(envelope.savedAt || "");
			if (
				!Number.isFinite(saved) ||
				Date.now() - saved > ttlHours * 3_600_000
			) {
				return null;
			}
		}
		return envelope.payload as T;
	} catch {
		return null;
	}
}

async function diskCacheSet<T>(key: string, data: T): Promise<void> {
	if (!isNode || !fs || !cacheRoot) {
		return;
	}
	try {
		await fs.mkdir(cacheRoot, { recursive: true });
		const envelope: DiskCacheEnvelope<T> = {
			savedAt: new Date().toISOString(),
			payload: data,
		};
		await fs.writeFile(diskCacheFile(key), JSON.stringify(envelope), {
			encoding: "utf8",
		});
	} catch {}
}

async function appendLog(fileName: string, line: string): Promise<void> {
	if (!isNode || !fs || !path || !logRoot) {
		return;
	}
	try {
		await fs.mkdir(logRoot, { recursive: true }).catch(() => {});
		const file = path.resolve(logRoot, fileName);
		await fs.appendFile(file, `${line}\n`, { encoding: "utf8" });
	} catch {}
}

