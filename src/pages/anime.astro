---
/**
 * 番剧收藏页：数据经 utils/anime-data（AnimeSource 分发，本地/快照/Dev热加载）
 * 构建期/Dev环境取得后交给客户端岛渲染（筛选/过渡/加载更多均为交互态）。
 */
import AnimeSection from "@components/organisms/AnimeSection.svelte";
import I18nKey from "@i18n/i18nKey";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { resolveI18nText } from "@utils/i18n-utils";
import { animeConfig } from "@/config/animeConfig";
import { getAnimeList, getAnimeSnapshotMeta } from "../utils/anime-data";

if (!animeConfig.enable) {
	return Astro.redirect("/404/");
}

const pageTitle = resolveI18nText(animeConfig.title, I18nKey.anime);
const pageDescription = resolveI18nText(
	animeConfig.description,
	I18nKey.animeBanner,
);

const animes = await getAnimeList();

// 统计条：总数 / 平均评分 / 快照同步时间（格式与 games 页统计条一致）
const snapshotMeta = getAnimeSnapshotMeta();
const ratedAnimes = animes.filter((anime) => anime.rating > 0);
const stats =
	animes.length > 0
		? {
				total: animes.length,
				avgRating:
					ratedAnimes.length > 0
						? (
								ratedAnimes.reduce((sum, anime) => sum + anime.rating, 0) /
								ratedAnimes.length
							).toFixed(1)
						: "0.0",
				lastUpdated: snapshotMeta
					? new Date(snapshotMeta.fetchedAt).toLocaleString("zh-CN", {
							year: "numeric",
							month: "2-digit",
							day: "2-digit",
							hour: "2-digit",
							minute: "2-digit",
							hour12: false,
							timeZone: "Asia/Shanghai",
						})
					: undefined,
			}
		: null;
---

<MainGridLayout title={pageTitle} description={pageDescription} page="anime">
    <AnimeSection animes={animes} {stats} title={pageTitle} subtitle={pageDescription} client:visible></AnimeSection>
</MainGridLayout>
