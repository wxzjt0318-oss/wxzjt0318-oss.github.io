---
/**
 * 留言板：站点级留言页。
 * 评论区复用主题的评论组件（Twikoo / Giscus，随 commentConfig 切换，懒加载、Swup 安全），
 * 不再自带一份 SDK 与初始化脚本——旧脚本每次换页都会重复注册监听并反复初始化。
 * 留言挂在固定路径 /visitorbook 上（与旧版一致，历史留言不受影响）。
 * 评论关闭时只显示介绍区，不加载任何评论资源。
 */
import Card from "@components/atoms/display/Card.svelte";
import PageHeader from "@components/atoms/display/PageHeader.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { Icon } from "astro-icon/components";
import { commentConfig, resolveCommentOptions, siteConfig } from "@/config";
import type { CommentContext } from "@/types/commentConfig";

const pageTitle = "留言板";
const pageSubtitle = "留下你的足迹，分享你的想法";

const features = [
	{
		icon: "material-symbols:lightbulb-outline-rounded",
		title: "分享想法",
		text: "聊聊你对文章或番剧的看法",
	},
	{
		icon: "material-symbols:rate-review-outline-rounded",
		title: "建议反馈",
		text: "网站哪里不好用，欢迎告诉我",
	},
	{
		icon: "material-symbols:edit-note-rounded",
		title: "记录心情",
		text: "今天过得怎么样，随手写两句",
	},
	{
		icon: "material-symbols:forum-outline-rounded",
		title: "互动交流",
		text: "和其他访客打个招呼吧",
	},
];

const notices = [
	"请保持友善和尊重，营造良好的交流氛围",
	"欢迎分享你的想法，也可以提出对网站的建议",
	"你的每一条留言都是对我最大的支持 ✨",
];

const options = resolveCommentOptions(commentConfig);
const context: CommentContext = {
	key: "page:visitorbook",
	path: "/visitorbook",
	title: pageTitle,
	language: siteConfig.lang,
};

const Twikoo =
	options?.provider === "twikoo"
		? (await import("@components/organisms/comment/Twikoo.astro")).default
		: null;
const Giscus =
	options?.provider === "giscus"
		? (await import("@components/organisms/comment/Giscus.astro")).default
		: null;
---

<MainGridLayout title={pageTitle} description={pageSubtitle}>
	<div class="visitorbook">
		<Card color="var(--card-bg)" radius="l" class="visitorbook__intro">
			<PageHeader title={pageTitle} subtitle={pageSubtitle} icon="material-symbols:chat-outline-rounded" />

			<p class="visitorbook__welcome">
				欢迎来到留言板！这里是一个自由交流的空间，无论你想说什么，都欢迎在下方留言。
			</p>

			<ul class="visitorbook__features">
				{features.map((item) => (
					<li class="visitorbook__feature">
						<span class="visitorbook__feature-icon" aria-hidden="true">
							<Icon name={item.icon} />
						</span>
						<span class="visitorbook__feature-text">
							<strong>{item.title}</strong>
							<span>{item.text}</span>
						</span>
					</li>
				))}
			</ul>

			<aside class="visitorbook__notice" aria-label="温馨提示">
				<span class="visitorbook__notice-title">
					<Icon name="material-symbols:info-outline-rounded" aria-hidden="true" />
					温馨提示
				</span>
				<ul>
					{notices.map((text) => <li>{text}</li>)}
				</ul>
			</aside>
		</Card>

		{options && (
			<Card color="var(--card-bg)" radius="l" class="visitorbook__board">
				<h2 class="visitorbook__board-title">
					<Icon name="material-symbols:edit-square-outline-rounded" aria-hidden="true" />
					写下你的留言
				</h2>
				{Twikoo && options.provider === "twikoo" && (
					<Twikoo context={context} config={options.twikoo} lazy={options.lazy} />
				)}
				{Giscus && options.provider === "giscus" && (
					<Giscus context={context} config={options.giscus} lazy={options.lazy} />
				)}
			</Card>
		)}
	</div>
</MainGridLayout>

<style lang="stylus">
	.visitorbook
		display: flex
		flex-direction: column
		gap: 1rem
		width: 100%

	.visitorbook :global(.visitorbook__intro),
	.visitorbook :global(.visitorbook__board)
		padding: 1.5rem
		@media (min-width: 48rem)
			padding: 2rem

	.visitorbook__welcome
		margin: 1rem 0 0
		color: var(--on-surface-variant)
		font: var(--m3e-type-body-large)

	.visitorbook__features
		display: grid
		grid-template-columns: repeat(2, minmax(0, 1fr))
		@media (min-width: 64rem)
			grid-template-columns: repeat(4, minmax(0, 1fr))
		gap: 0.75rem
		margin: 1.25rem 0 0
		padding: 0
		list-style: none

	.visitorbook__feature
		display: flex
		flex-direction: column
		align-items: flex-start
		gap: 0.625rem
		padding: 1rem
		border: 1px solid var(--outline-variant)
		border-radius: var(--shape-corner-l)
		background: var(--surface-container-low)
		transition: border-color var(--m3e-duration-short) var(--m3e-easing-standard), transform var(--m3e-duration-short) var(--m3e-easing-standard)
		&:hover
			border-color: var(--primary)
			transform: translateY(-2px)

	.visitorbook__feature-icon
		display: inline-flex
		flex: none
		align-items: center
		justify-content: center
		width: 2.5rem
		height: 2.5rem
		border-radius: var(--shape-corner-m)
		background: var(--primary-container)
		color: var(--on-primary-container)
		> :global(svg)
			width: 1.375rem
			height: 1.375rem

	.visitorbook__feature-text
		display: flex
		flex-direction: column
		gap: 0.125rem
		min-width: 0
		> strong
			color: var(--on-surface)
			font: var(--m3e-type-title-small)
		> span
			color: var(--on-surface-variant)
			font: var(--m3e-type-body-small)

	.visitorbook__notice
		margin-top: 1.25rem
		padding: 1rem 1.25rem
		border-radius: var(--shape-corner-l)
		background: var(--secondary-container)
		color: var(--on-secondary-container)
		> ul
			display: flex
			flex-direction: column
			gap: 0.25rem
			margin: 0.5rem 0 0
			padding-left: 1.25rem
			list-style: disc
			font: var(--m3e-type-body-medium)

	.visitorbook__notice-title
		display: inline-flex
		align-items: center
		gap: 0.375rem
		font: var(--m3e-type-title-small)
		> :global(svg)
			width: 1.25rem
			height: 1.25rem

	.visitorbook__board-title
		display: flex
		align-items: center
		gap: 0.5rem
		margin: 0 0 1.25rem
		color: var(--on-surface)
		font: var(--m3e-type-title-large)
		> :global(svg)
			width: 1.5rem
			height: 1.5rem
			color: var(--primary)

	@media (prefers-reduced-motion: reduce)
		.visitorbook__feature
			transition: none
			&:hover
				transform: none
</style>
