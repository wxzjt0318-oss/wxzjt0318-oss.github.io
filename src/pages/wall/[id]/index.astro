---
/**
 * 旧的独立照片墙页：照片墙已并入相册详情页，这里只跳转过去，保留以前分享出去的链接。
 */
import { wallAlbums } from "@utils/photo-wall";
import { url } from "@utils/url-utils";

export function getStaticPaths() {
	return wallAlbums().map((album) => ({ params: { id: album.id } }));
}

return Astro.redirect(url(`/albums/${Astro.params.id}/`), 301);
---
